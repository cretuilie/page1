# --- ExpertAccounts API ---
# Gasesti tokenurile in ExpertAccounts:
# System Configurations → API Configuration
EA_BASE_URL=http://ro.ExpertAccounts.com/
EA_T1=pune_aici_token_1_secret
EA_T2=pune_aici_token_2_secret

# --- Claude (Anthropic) API ---
# Obtine cheia de pe: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-pune_cheia_ta_aici
